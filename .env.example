# BIIP-SIH2026 Environment Configuration
# Copy to .env and adjust as needed

# ============================================
# APPLICATION
# ============================================
APP_NAME=BIIP
APP_VERSION=1.0.0-sih2026
DEBUG=true
ENVIRONMENT=development

# ============================================
# BACKEND (FastAPI)
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# Database
DATABASE_URL=sqlite:///./biip.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ============================================
# FRONTEND (Vite)
# ============================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# ============================================
# AI / MODEL PATHS
# ============================================
# Models are downloaded at runtime or placed in backend/models/
# Do not commit model weights to git
MODEL_DIR=./models

# OCR
PADDLE_OCR_LANG=en
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_DET_MODEL_DIR=${MODEL_DIR}/paddleocr/det
PADDLE_OCR_REC_MODEL_DIR=${MODEL_DIR}/paddleocr/rec
PADDLE_OCR_CLS_MODEL_DIR=${MODEL_DIR}/paddleocr/cls

# Face Recognition (InsightFace ONNX)
INSIGHTFACE_MODEL_PATH=${MODEL_DIR}/insightface/buffalo_l/w600k_r50.onnx
INSIGHTFACE_DET_MODEL_PATH=${MODEL_DIR}/insightface/buffalo_l/det_10g.onnx
FACE_EMBEDDING_DIM=512
FACE_MATCH_THRESHOLD=0.35
FACE_QUALITY_THRESHOLD=0.5

# Liveness (Prototype)
LIVENESS_ENABLED=true
LIVENESS_THRESHOLD=0.6

# MRZ
MRZ_ENABLED=true

# Barcode/QR
BARCODE_ENABLED=true

# ============================================
# OFFLINE / FRESHNESS
# ============================================
# Freshness policies (hours)
FRESHNESS_WATCHLIST_HOURS=6
FRESHNESS_VISA_HOURS=24
FRESHNESS_PASSPORT_HOURS=168
FRESHNESS_NATIONAL_ID_HOURS=168

# Offline mode
OFFLINE_MODE=false
SYNC_INTERVAL_SECONDS=300

# ============================================
# SIMULATED CENTRAL SERVICE
# ============================================
CENTRAL_SERVICE_ENABLED=true
CENTRAL_SERVICE_URL=http://localhost:8001
CENTRAL_SERVICE_SIMULATED=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# SECURITY
# ============================================
# For prototype only - use proper secrets in production
SECRET_KEY=dev-secret-key-change-in-production
API_KEY_HEADER=X-API-Key

# ============================================
# DEMO / TESTING
# ============================================
DEMO_MODE=true
DETERMINISTIC_SEED=42